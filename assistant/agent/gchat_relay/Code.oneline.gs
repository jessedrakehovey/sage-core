// Sage Chat relay v5: forwards every Chat event to Mission Control (port 8443), retries and holds taps while it restarts. Source of truth with comments: assistant/agent/gchat_relay/Code.gs in the the organization vault.
var TAPS_ = { card_answer: 1, card_undo: 1, card_edit_submit: 1 }; var HOLD_PREFIX_ = 'held_'; function post_(endpoint, secret, event, heldAt) { var headers = { 'X-Sage-Relay': secret }; if (heldAt) headers['X-Sage-Late'] = String(heldAt); return UrlFetchApp.fetch(endpoint, { method: 'post', contentType: 'application/json', headers: headers, payload: JSON.stringify(event || {}), muteHttpExceptions: true, followRedirects: false, }); } function relay_(event) { var props = PropertiesService.getScriptProperties(); var endpoint = props.getProperty('ENDPOINT'); var secret = props.getProperty('RELAY_SECRET'); if (!endpoint || !secret) { return say_('Relay not configured (ENDPOINT / RELAY_SECRET).'); } var fn = (event && event.relayFunction) || ''; var tries = TAPS_[fn] || !fn ? 3 : 1; var last = ''; for (var i = 0; i < tries; i++) { if (i) Utilities.sleep(1500); try { var resp = post_(endpoint, secret, event, 0); var code = resp.getResponseCode(); if (code === 200) { var out = JSON.parse(resp.getContentText() || '{}'); try { flushQueue(); } catch (e) { console.error('flush: ' + e); } return out; } last = code + ': ' + resp.getContentText().slice(0, 200); if (code === 401 || code === 403) break; } catch (e) { last = String(e); } } console.error('relay: Mission Control unreachable (' + last + ')'); if (fn === 'card_edit') { return say_('Sage\'s computer is restarting. Tap Edit again in a minute.'); } hold_(event); if (fn === 'card_answer') { var p = (event.commonEventObject || {}).parameters || {}; var choice = String(p.option || '').replace(/\s*\(Recommended\)\s*/, ''); return { hostAppDataAction: { chatDataAction: { updateMessageAction: { message: { cardsV2: [{ cardId: String(p.qid || 'held'), card: { sections: [{ widgets: [{ textParagraph: { text: '<b>' + escape_(choice) + '</b> - got it.<br>Sage\'s computer is restarting; this goes through the moment it is back. ' + 'If it can\'t, you\'ll get a fresh card.' } }] }] }, }] } } } }, }; } if (fn === 'card_edit_submit') { return { action: { navigations: [{ endNavigation: { action: 'CLOSE_DIALOG' } }], notification: { text: 'Got it. Sage will send this the moment its computer is back.' } } }; } if (fn === 'card_undo') { return say_('Got the Undo. Sage will apply it the moment its computer is back.'); } return {}; } function say_(text) { return { hostAppDataAction: { chatDataAction: { createMessageAction: { message: { text: text } } } } }; } function escape_(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); } function slim_(event) { var chat = event.chat || {}; var out = { relayFunction: event.relayFunction || '', commonEventObject: event.commonEventObject || {}, chat: {} }; if (chat.user) out.chat.user = chat.user; if (chat.buttonClickedPayload) { var m = chat.buttonClickedPayload.message || {}; out.chat.buttonClickedPayload = { message: { name: m.name, space: m.space, thread: m.thread } }; if (chat.buttonClickedPayload.space) out.chat.buttonClickedPayload.space = chat.buttonClickedPayload.space; } if (chat.messagePayload) { var mm = chat.messagePayload.message || {}; out.chat.messagePayload = { space: chat.messagePayload.space, message: { name: mm.name, text: String(mm.text || '').slice(0, 6000), argumentText: String(mm.argumentText || '').slice(0, 6000), sender: mm.sender, space: mm.space, thread: mm.thread, createTime: mm.createTime, attachment: mm.attachment } }; } if (chat.addedToSpacePayload) out.chat.addedToSpacePayload = chat.addedToSpacePayload; return out; } function hold_(event) { try { var key = HOLD_PREFIX_ + Date.now() + '_' + Math.floor(Math.random() * 1e6); var s = JSON.stringify(slim_(event)); if (s.length > 8500) { var e2 = slim_(event); if (e2.chat.messagePayload) { e2.chat.messagePayload.message.text = e2.chat.messagePayload.message.text.slice(0, 2500); e2.chat.messagePayload.message.argumentText = ''; delete e2.chat.messagePayload.message.attachment; } s = JSON.stringify(e2).slice(0, 8900); } PropertiesService.getScriptProperties().setProperty(key, s); } catch (e) { console.error('hold: ' + e); } } function flushQueue() { var lock = LockService.getScriptLock(); if (!lock.tryLock(5000)) return; try { var props = PropertiesService.getScriptProperties(); var all = props.getProperties(); var keys = Object.keys(all).filter(function (k) { return k.indexOf(HOLD_PREFIX_) === 0; }).sort(); if (!keys.length) return; var endpoint = all.ENDPOINT, secret = all.RELAY_SECRET; for (var i = 0; i < keys.length; i++) { var heldAt = Number(keys[i].split('_')[1]) || Date.now(); var resp; try { resp = post_(endpoint, secret, JSON.parse(all[keys[i]]), heldAt); } catch (e) { return; } if (resp.getResponseCode() !== 200) return; props.deleteProperty(keys[i]); } } finally { lock.releaseLock(); } } function installFlushTrigger() { ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'flushQueue') ScriptApp.deleteTrigger(t); }); ScriptApp.newTrigger('flushQueue').timeBased().everyMinutes(1).create(); } function onMessage(event)          { return relay_(event); } function onAddedToSpace(event)     { return relay_(event); } function onRemovedFromSpace(event) { return relay_(event); } function onAppCommand(event)       { return relay_(event); } function card_answer(event) { event.relayFunction = 'card_answer'; return relay_(event); } function card_undo(event)   { event.relayFunction = 'card_undo'; return relay_(event); } function card_edit(event)   { event.relayFunction = 'card_edit'; return relay_(event); } function card_edit_submit(event) { event.relayFunction = 'card_edit_submit'; return relay_(event); } function pingTest() { var endpoint = PropertiesService.getScriptProperties().getProperty('ENDPOINT') || ''; var url = endpoint.replace(/\/events$/, '/ping') + '?src=appsscript'; var r = UrlFetchApp.fetch(url, { muteHttpExceptions: true }); console.log(r.getResponseCode() + ' ' + r.getContentText()); }
