<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>the owner assistant - wake-on-work tick. Runs assistant/scripts/operator_cron.ps1: token-free sensors (IMAP read-only, secret iCal, project dates) add tickets to one queue; only when the queue is non-empty, one headless claude -p Sonnet operator drains it (draft-only, explicit allowedTools). Empty queue = 0 tokens. Every 30 min, 7:45 AM - 9:45 PM.</Description>
    <URI>\the organization</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>{{USER_SID}}</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT25M</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-09-22T07:45:00-07:00</StartBoundary>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
      <Repetition>
        <Interval>PT30M</Interval>
        <Duration>PT14H</Duration>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "{{ORG_ROOT}}\assistant\scripts\operator_cron.ps1"</Arguments>
    </Exec>
  </Actions>
</Task>
