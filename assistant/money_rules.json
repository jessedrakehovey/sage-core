 "rules": [
  {
   "id": "r-stripe-in",
   "match": "stripe|square inc|sq \\*.*deposit",
   "sign": "in",
   "bucket": "income:other"
  },
  {
   "id": "r-irs",
   "match": "irs |usataxpymt|us treasury|direct pay",
   "sign": "out",
   "bucket": "tax:federal"
  },
  {
   "id": "r-ftb",
   "match": "franchise tax|ftb |cal ftb",
   "sign": "out",
   "bucket": "tax:california"
  },
  {
   "id": "r-music",
   "match": "musicbed|artlist|epidemic sound|soundstripe",
   "sign": "out",
   "bucket": "biz:music"
  },
  {
   "id": "r-software",
   "match": "adobe|blackmagic|frame\\.io|dropbox|google storage|google one|workspace|typeform|vercel|github|anthropic|openai|notion|canva|tailscale|backblaze|lumafusion|topaz|davinci",
   "sign": "out",
   "bucket": "biz:software"
  },
  {
   "id": "r-ads",
   "match": "google ads|googleads|google \\*ads|meta ads|facebk ads|the knot|weddingwire|zola",
   "sign": "out",
   "bucket": "biz:ads"
  },
  {
   "id": "r-gear",
   "match": "b&h|bhphoto|adorama|lensrentals|borrowlenses|sony|smallrig|dji|rode |sennheiser|tascam|zoom corp|sandisk|samsung ssd",
   "sign": "out",
   "bucket": "biz:gear"
  },
  {
   "id": "r-fees",
   "match": "wire fee|monthly fee|service charge|processing fee",
   "sign": "out",
   "bucket": "biz:fees"
  },
  {
   "id": "r-phone",
   "match": "verizon|t-mobile|at&t|spectrum|cox comm|starlink",
   "sign": "out",
   "bucket": "biz:phone"
  },
  {
   "id": "r-fuel",
   "match": "chevron|shell oil|arco|76 |costco gas|exxon|mobil",
   "sign": "out",
   "bucket": "personal:car"
  },
  {
   "id": "r-groceries",
   "match": "trader joe|whole foods|vons|ralphs|costco whse|sprouts|albertsons|safeway",
   "sign": "out",
   "bucket": "personal:groceries"
  },
  {
   "id": "r-dining",
   "match": "doordash|uber eats|grubhub|starbucks|chipotle|in-n-out|taco bell",
   "sign": "out",
   "bucket": "personal:dining"
  },
  {
   "id": "r-personal-subs",
   "match": "netflix|spotify|hulu|disney plus|apple\\.com/bill|youtube premium|amazon prime",
   "sign": "out",
   "bucket": "personal:subscriptions"
  },
  {
   "id": "r-utilities",
   "match": "so cal edison|sce |socalgas|edison|water dist|pg&e",
   "sign": "out",
   "bucket": "personal:utilities"
  },
  {
   "id": "r-health",
   "match": "pharmacy|cvs|walgreens|kaiser|dignity health|medical",
   "sign": "out",
   "bucket": "personal:health"
  },
  {
   "id": "r-transfer",
   "match": "^transfer|xfer to|xfer from|online transfer|relay transfer|bucket transfer",
   "bucket": "transfer"
  }
 ],
 "learned": []
}
