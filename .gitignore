# --- Secrets & machine-local config -----------------------------------------
.claude/settings.local.json

# --- Generated / local indices ----------------------------------------------
scripts/.semantic_store/
**/__pycache__/
*.pyc

# --- Volatile state ledgers (read by tooling, not history) -------------------
scripts/**/*_state.json
scripts/**/state.json

scripts/lib/.cache/

