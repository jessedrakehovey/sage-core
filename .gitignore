!assistant/data/sop_map.json
!assistant/data/client_texts.json
assistant/out/
assistant/web/index.html
dashboard/data/
dashboard/index.html

# Emailed voice memos (large binaries; transcripts live in Raw/Conversations/)
Raw/Audio/
# Ad Scout: lead keys + spend (and API secrets)
ads/data/
ads/secrets.json

# --- Regenerated Travel Scout site outputs (75 MB photo cache + 127 MB standalone page;
#     rebuilt by travel/scripts/build_site.py, deployed to Vercel from disk) ----------
travel/web/photos/
travel/web/travel-scout-standalone.html

# --- Resolve log dirs created by a relative-path bug in the scripting host ---------
**/#ProgramData#*/
scripts/card_ingest/.cache/

# agent channel config (project ids, key paths) is machine-local
assistant/agent/*.local.json
scripts/drive_ingest/stuck.json

# film chain comparison stills (large, regenerated by resolve_build.py compare)
editor/grade/film/out/
editor/grade/film/models/face_recognition_sface_2021dec.onnx

# doer tool scores: runtime state the doer rewrites after every run (failed builds as a 'protected core' change, 2026-10-17)
assistant/doer/tools/meta.json
# the owners' phone directory (contacts.py rewrites it from the git-ignored book; same private data)
Wiki/People/Contacts.md

# --- sage-core releases + staged engines (release.py / updater.py / the installer build) ---
dist/
.sage-engines/
assistant/installer/windows/Output/
